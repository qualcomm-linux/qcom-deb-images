# Extra kernel arguments for the installer's GRUB entries and, through
# d-i's add-kernel-opts, the target's.
# Read by build-installer.sh, which skips the # comment lines and joins the
# rest; not shipped in the ISO itself.
clk_ignore_unused pd_ignore_unused

# Some DTs (e.g. the Glymur CRD's) set /chosen/stdout-path to the serial
# port, which then becomes /dev/console. d-i runs on /dev/console, so it
# would start on serial and leave the screen blank. An explicit console= overrides stdout-path: run the
# installer (and the target's console) on the screen.
console=tty0
