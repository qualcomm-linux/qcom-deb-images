#!/bin/bash
# Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
# SPDX-License-Identifier: BSD-3-Clause

# live-build binary-stage hook (config/hooks/normal/*.binary).
#
# Runs non-chrooted, cwd=binary/, after lb installer has filled the pool and
# generated its indices, and before binary_checksums and binary_iso.
#
# Removes the stock Debian kernel from the ISO's package pool. lb installer
# adds the kernel module udebs (pool-udeb/*/l/linux*/, ~71 MB) regardless
# of --linux-packages none, but the installer boots the custom kernel from
# replace-di-kernel.sh, which can't load them.
#
# Also drops the stock kernel debs (linux-image-*, and Debian's split
# linux-base-*, linux-binary-*, linux-modules-*): build.sh adds the custom
# kernel to the pool and preseeds base-installer to install it on the target.
# The debs build.sh added are listed in config/kernel-debs.list and stay,
# since the stock kernel can share their pool directory.
#
# Then it regenerates the indices (see pool-lib.sh).
set -euo pipefail

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
. "$HOOK_DIR/../../pool-lib.sh"

REMOVED=()
shopt -s nullglob

for f in pool-udeb/*/l/linux/*.udeb pool-udeb/*/l/linux-signed-*/*.udeb; do
    REMOVED+=("$f")
done

KERNEL_DEBS_LIST="$HOOK_DIR/../../kernel-debs.list"
for f in pool/*/l/linux/*.deb pool/*/l/linux-signed-*/*.deb; do
    case "${f##*/}" in
        linux-image-* | linux-base-[0-9]* | linux-binary-* | linux-modules-*) ;;
        *) continue ;;
    esac
    if [ -f "$KERNEL_DEBS_LIST" ] && grep -qxF "${f##*/}" "$KERNEL_DEBS_LIST"; then
        continue
    fi
    REMOVED+=("$f")
done

pool_remove "the stock kernel" "${REMOVED[@]}"
