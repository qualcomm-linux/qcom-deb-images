# Sourced by postinst.sh. Installs the pins for the backports and Qualcomm
# Linux sources apt-setup added; d-i has no preseed for pins.

for pref in "$SRC"/apt/*.pref; do
    [ -f "$pref" ] || continue
    install_file "$pref" "/etc/apt/preferences.d/${pref##*/}" 0644
done
