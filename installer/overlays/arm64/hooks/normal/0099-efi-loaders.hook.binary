#!/bin/bash
# Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
# SPDX-License-Identifier: BSD-3-Clause

# live-build binary-stage hook (config/hooks/normal/*.binary).
#
# HACK: goes together with the "build a disk image instead of an ISO" hack
# and should be dropped once the image is an ISO again.
#
# live-build's binary_grub-efi exits early for hdd images, so nothing
# installs the UEFI removable-media loader and the firmware skips the
# disk. Install the same signed shim and GRUB binaries binary_grub-efi uses
# for ISO builds, taken from the debs already in the image's pool:
#
#   shimaa64.efi.signed -> EFI/boot/bootaa64.efi
#   gcdaa64.efi.signed  -> EFI/boot/grubaa64.efi
#   mmaa64.efi.signed   -> EFI/boot/mmaa64.efi
#
# It also installs the GRUB font that live-build's efi-image normally
# copies, without which config.cfg's loadfont fails and the live-theme
# (all Unifont Regular 16) can't be drawn. The font is in grub-common on
# trixie and in grub2-common from forky on:
#
#   unicode.pf2         -> boot/grub/unicode.pf2
#                       -> boot/grub/fonts/unicode.pf2
#
# The signed GRUB sets feature_default_font_path, so config.cfg loads
# "unicode", which GRUB looks up as $prefix/fonts/unicode.pf2; the copy
# in boot/grub is kept for a GRUB without that feature.
#
# The gcd GRUB image finds its root through /.disk/info and loads
# /boot/grub/grub.cfg.
#
# Runs non-chrooted, cwd=binary/. Does nothing if binary_grub-efi already
# installed a loader.
set -euo pipefail

die() {
    echo "0099-efi-loaders: $*" >&2
    exit 1
}

if [ -e EFI/boot/bootaa64.efi ]; then
    exit 0
fi

find_deb() {
    local dir="$1" pattern="$2" deb
    for deb in "$dir"/$pattern; do
        if [ -f "$deb" ]; then
            echo "$deb"
            return 0
        fi
    done
    die "no $pattern in $dir"
}

SHIM_DEB="$(find_deb pool/main/s/shim-signed 'shim-signed_*_arm64.deb')"
HELPERS_DEB="$(find_deb pool/main/s/shim-helpers-arm64-signed \
    'shim-helpers-arm64-signed_*_arm64.deb')"
GRUB_DEB="$(find_deb pool/main/g/grub-efi-arm64-signed \
    'grub-efi-arm64-signed_*_arm64.deb')"
GRUB_COMMON_DEB="$(find_deb pool/main/g/grub2 'grub-common_*_arm64.deb')"

TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT

for deb in "$SHIM_DEB" "$HELPERS_DEB" "$GRUB_DEB" "$GRUB_COMMON_DEB"; do
    dpkg-deb -x "$deb" "$TMP_DIR"
done

for deb in pool/main/g/grub2/grub2-common_*_arm64.deb; do
    if [ -f "$deb" ]; then
        dpkg-deb -x "$deb" "$TMP_DIR"
    fi
done

if [ ! -f "$TMP_DIR/usr/share/grub/unicode.pf2" ]; then
    die "no unicode.pf2 in grub-common or grub2-common"
fi

install -D -m 0644 "$TMP_DIR/usr/lib/shim/shimaa64.efi.signed" \
    EFI/boot/bootaa64.efi
install -D -m 0644 "$TMP_DIR/usr/lib/grub/arm64-efi-signed/gcdaa64.efi.signed" \
    EFI/boot/grubaa64.efi
install -D -m 0644 "$TMP_DIR/usr/lib/shim/mmaa64.efi.signed" \
    EFI/boot/mmaa64.efi
install -D -m 0644 "$TMP_DIR/usr/share/grub/unicode.pf2" \
    boot/grub/unicode.pf2
install -D -m 0644 "$TMP_DIR/usr/share/grub/unicode.pf2" \
    boot/grub/fonts/unicode.pf2
