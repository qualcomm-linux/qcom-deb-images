# Kernel config fragment for an Incus host running both system containers and
# virtual machines, aimed at developers.
#
# Config tiers:
# [CORE]        - Required for Incus to function
# [RECOMMENDED] - Needed for common Incus features
# [OPTIONAL]    - Specialized features, enable if you use them

#
# Namespaces
#
# [CORE] Isolation primitives every container is built from; USER_NS is what
# makes Incus containers unprivileged by default
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_USER_NS=y

#
# Control groups
#
# Incus requires the cgroup2 hierarchy; it reads
# /sys/fs/cgroup/cgroup.controllers and degrades feature by feature when a
# controller is absent, so a missing one shows up as a limit silently doing
# nothing rather than as a startup failure.
#
# [CORE] Controllers behind limits.cpu, limits.memory and the device policy
CONFIG_CGROUPS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_BPF=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y

# [RECOMMENDED] limits.cpu.allowance needs bandwidth control; the io
# controller backs limits.disk.* and the rest round out the accounting Incus
# reports in `incus info`
CONFIG_CFS_BANDWIDTH=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_BLK_CGROUP=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_NET_CLS_CGROUP=m

#
# Security
#
# [CORE] seccomp, including the user notification mechanism Incus relies on
# to emulate privileged syscalls inside unprivileged containers
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# [CORE] keyring isolation per container
CONFIG_KEYS=y

# [RECOMMENDED] Incus generates a per-instance AppArmor profile and needs
# profile namespacing/stacking to confine nested Incus or Docker
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_SELINUX=y

#
# Containers
#
# [CORE] FUSE backs LXCFS, which gives each container its own view of
# /proc/meminfo, /proc/cpuinfo and friends
CONFIG_FUSE_FS=m

# [CORE] POSIX message queues, checked by lxc-checkconfig
CONFIG_POSIX_MQUEUE=y

# [CORE] ACL and xattr support on the backing filesystem, without which
# unpacking an image loses file capabilities and AppArmor labels
# Note: CONFIG_EXT4_FS typically in defconfig
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y

# [OPTIONAL] `incus snapshot` of a running container via CRIU, plus the socket
# diag modules CRIU needs to dump open connections
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_FHANDLE=y
CONFIG_USERFAULTFD=y
CONFIG_UNIX_DIAG=m
CONFIG_INET_DIAG=m
CONFIG_PACKET_DIAG=m
CONFIG_NETLINK_DIAG=m

#
# Virtual machines
#
# arm64 defconfig already enables KVM itself but none of the vhost transports
# Incus drives a VM through, which is why `incus launch --vm` complains about
# vhost_vsock on a defconfig kernel.
#
# [CORE] Hardware virtualization, provides /dev/kvm
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y

# [CORE] vsock transport for incus-agent: exec, file push/pull and reporting
# the VM's state back to the host all ride on it, so a VM on a kernel without
# vhost_vsock boots but never becomes manageable
CONFIG_VSOCKETS=m
CONFIG_VHOST_VSOCK=m

# [CORE] Host side virtio-net acceleration for VM NICs
CONFIG_VHOST_NET=m

# [CORE] tap devices backing VM NICs
CONFIG_TUN=y
CONFIG_MACVTAP=m

# [OPTIONAL] limits.hugepages
CONFIG_HUGETLBFS=y

# [OPTIONAL] PCI, GPU and SR-IOV passthrough into VMs
CONFIG_VFIO=m
CONFIG_VFIO_PCI=m

# [OPTIONAL] guest side drivers, only relevant if this same kernel is booted
# inside an Incus VM; VIRTIO_FS is what mounts the shares Incus sets up with
# virtiofsd when a disk device is added
CONFIG_VIRTIO_FS=m
CONFIG_VIRTIO_BLK=m
CONFIG_VIRTIO_NET=m
CONFIG_VIRTIO_CONSOLE=m
CONFIG_VIRTIO_BALLOON=m
CONFIG_VIRTIO_VSOCKETS=m

#
# Storage pools
#
# [CORE] loop devices back the file-based pool that `incus admin init`
# creates by default when no spare block device is offered
CONFIG_BLK_DEV_LOOP=y

# [CORE] overlayfs, both for Incus's own image unpacking and so Docker can
# run nested inside an Incus container
CONFIG_OVERLAY_FS=m

# [RECOMMENDED] btrfs driver, the default when a spare block device is given;
# Incus uses subvolumes for instances and snapshots
CONFIG_BTRFS_FS=m
CONFIG_BTRFS_FS_POSIX_ACL=y

# [RECOMMENDED] lvm driver, which uses thin pools for instances and snapshots
CONFIG_BLK_DEV_DM=m
CONFIG_DM_THIN_PROVISIONING=m
CONFIG_DM_SNAPSHOT=m

# [RECOMMENDED] the lvm and ceph drivers both load nbd
CONFIG_BLK_DEV_NBD=m

# [RECOMMENDED] quota support, needed for size limits on an ext4 dir pool
# (nothing here enables XFS, so CONFIG_XFS_QUOTA is deliberately left out)
CONFIG_QUOTA=y
CONFIG_QFMT_V2=y

# [OPTIONAL] ceph and cephfs pools
CONFIG_BLK_DEV_RBD=m
CONFIG_CEPH_FS=m

#
# Networking
#
# [CORE] veth pairs for container NICs and the managed bridge incusbr0
CONFIG_VETH=m
CONFIG_BRIDGE=m
CONFIG_BRIDGE_VLAN_FILTERING=y

# [CORE] br_netfilter, so the host firewall sees traffic crossing the bridge;
# Incus warns at startup when the module is missing
CONFIG_BRIDGE_NETFILTER=m
CONFIG_NF_CONNTRACK_BRIDGE=m

# [RECOMMENDED] 802.1Q, for vlan and bridged NICs on a tagged uplink
CONFIG_VLAN_8021Q=m

# [RECOMMENDED] the remaining instance NIC types
CONFIG_MACVLAN=m
CONFIG_IPVLAN=m
CONFIG_DUMMY=m

# [CORE] IPv6, which managed bridges hand out by default
CONFIG_IPV6=y

# [CORE] netfilter core; Incus drives nftables directly for the NAT and
# filter rules attached to each managed bridge
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=m
CONFIG_NF_NAT=m
CONFIG_NF_NAT_MASQUERADE=y
CONFIG_NF_DEFRAG_IPV4=m
CONFIG_NF_DEFRAG_IPV6=m
CONFIG_NF_REJECT_IPV4=m
CONFIG_NF_REJECT_IPV6=m

# [CORE] nftables, Incus's default firewall backend
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_BRIDGE=m
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_CT=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_REJECT_INET=m
CONFIG_NFT_FIB=m
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NF_LOG_SYSLOG=m

# [RECOMMENDED] xtables comment match, checked by lxc-checkconfig and used by
# the legacy iptables backend Incus falls back to
CONFIG_NETFILTER_XTABLES=m
CONFIG_NETFILTER_XT_MATCH_COMMENT=m

# [RECOMMENDED] traffic control bits behind limits.ingress / limits.egress
# and limits.priority on an instance NIC
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_HTB=m
CONFIG_NET_SCH_INGRESS=m
CONFIG_NET_CLS_U32=m
CONFIG_NET_CLS_ACT=y
CONFIG_NET_ACT_POLICE=m

# [OPTIONAL] OVN networks, which tunnel over geneve on top of openvswitch
CONFIG_OPENVSWITCH=m
CONFIG_GENEVE=m
CONFIG_VXLAN=m
