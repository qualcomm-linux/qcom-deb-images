# block device encryption with LUKS/cryptsetup and systemd-cryptsetup
CONFIG_DM_CRYPT=m
# udev relies on device-mapper uevents to create /dev/mapper/* links and to let
# systemd know when the decrypted device is ready
CONFIG_DM_UEVENT=y
# AF_ALG userspace interface to kernel ciphers and hashes; cryptsetup uses it to
# process LUKS keyslots and for "cryptsetup benchmark"
CONFIG_CRYPTO_USER_API_SKCIPHER=m
CONFIG_CRYPTO_USER_API_HASH=m
