# the installer is an iso-hybrid image written to a USB stick; d-i's
# cdrom-detect and live-boot mount it as ISO 9660; values as in Debian's
# kernel config
CONFIG_ISO9660_FS=m
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
